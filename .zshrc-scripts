fzf-pj() {

    # Usa fzf para seleccionar la carpeta
    selected_path=$(find /home/enzom/dev -maxdepth 1 -type d | fzf)

    # Verifica si se seleccionó algo
    if [ -n "$selected_path" ]; then
        # Mueve el directorio actual a la carpeta seleccionada
        eval "cd '$selected_path'"
    fi
    zle reset-prompt
}

zle -N fzf-pj

bindkey '^P' fzf-pj


# Función que lista directorios de htdocs, selecciona con fzf y cambia de directorio + abre nvim
function htdocs_nvim() {
    local dir
    dir=$(find /opt/lampp/htdocs -maxdepth 1 -mindepth 1 -type d | fzf --prompt="Select htdocs dir: ") || return
    cd "$dir" || return
    nvim
    # Al cerrar nvim, seguimos en el mismo directorio
}

# Crear un widget de Zsh
zle -N htdocs_nvim

# Asignar Ctrl+X a ese widget
bindkey '^X' htdocs_nvim



pom() {
  local split="$POMO_SPLIT"

  if [[ -z "$split" ]]; then
    split=$(gum choose "25/5" "50/10" "all done" \
      --header "Choose a pomodoro split.")
  fi

  local work break

  case "$split" in
    "25/5")
      work="25m"
      break="5m"
      ;;
    "50/10")
      work="50m"
      break="10m"
      ;;
    "all done")
      return 0
      ;;
    *)
      return 1
      ;;
  esac

  # Work timer
  timer "$work" && {
    notify-send "Pomodoro" "Work Timer is up! Take a break 😊"
    paplay /usr/share/sounds/freedesktop/stereo/complete.oga 2>/dev/null
  }

  if gum confirm "Ready for a break?"; then
    timer "$break" && {
      notify-send "Pomodoro" "Break is over! Get back to work 😬"
      paplay /usr/share/sounds/freedesktop/stereo/message.oga 2>/dev/null
    }
  else
    pom
  fi
}

