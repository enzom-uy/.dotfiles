{
  "id": "bunnipom",
  "name": "Bunni Pom",
  "version": "1.0.9",
  "minNoctaliaVersion": "4.3.0",
  "author": "Sovereign",
  "license": "MIT",
  "repository": "https://github.com/enzom-uy/noctalia-plugins",
  "description": "Shows the current Bashbunni's pom util state",
  "tags": ["Bar"],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml",
    "main": "Main.qml",
    "launcherProvider": "LauncherProvider.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "showTempValue": true,
      "showTempUnit": true,
      "showConditionIcon": true,
      "tooltipOption": "everything",
      "commandPrefix": "bunnipom",
      "customColor": "none"
    }
  }
}
