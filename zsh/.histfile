clear
ls
cd
ssh-keygen -t ed25519 -C "enzom.dev@gmail.com"
clear
eval "$(ssh-agent -s)"
ssh-add ~/.ssh/id_ed25519
cat ~/.ssh/id_ed25519.pub
cd .config
ls
gcl
git
git clone git@github.com:enzom-uy/nvim.git
git config --global user.name "enzom-uy"
git config --global user.email "enzom.dev@gmail.com"
sudo pacman -S lazygit --noconfirm
npm
sudo pacman -S node npm --noconfirm
sudo pacman -S nodejs npm --noconfirm
tmux
sudo pacman -S ripgrep fzf tmux --noconfirm
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
